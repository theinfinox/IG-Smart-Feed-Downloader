{
  "manifest_version": 3,
  "name": "Bulk Downloader for IG",
  "version": "1.2.0",
  "description": "Fast, private client-side bulk downloader for your saved Instagram collections, posts, and carousels.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "tabs",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bulk Downloader for IG",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["feed_collector.js"],
      "run_at": "document_idle"
    }
  ]
}
